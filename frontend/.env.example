# Copy to frontend/.env for local use, and set these variables in Vercel for deployment.
# Use the SAME Firebase project as your SoilSense mobile app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Business inquiries open the customer's Gmail or email application with a draft.
# A customer must still press Send; this is not automatic backend email delivery.
VITE_SOILSENSE_CONTACT_EMAIL=report.test.email.0@gmail.com

# Optional: external APK URL (e.g. a GitHub Release asset).
# Set for browser-upload-friendly packages that do not bundle the APK file.
VITE_SOILSENSE_APK_URL=
